# =============================================================================
# Pariksha — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — from your project's Settings > API page
# These are SAFE to expose in the browser (anon/public keys only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Supabase Service Role Key — SERVER ONLY
# This key bypasses Row Level Security. NEVER expose to the browser.
# Used only in: scripts/seed-admin.ts and server-side admin operations.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Admin Bootstrap Credentials
# Used exclusively by: scripts/seed-admin.ts (npm run seed:admin)
# These credentials create the single teacher account.
# Use a strong password (min 8 chars, ideally 16+ with mixed chars).
# -----------------------------------------------------------------------------
ADMIN_EMAIL=teacher@yourdomain.com
ADMIN_PASSWORD=change-this-to-a-very-strong-password

